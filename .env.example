# Для Docker: скопируйте файл в .env рядом с docker-compose.yml и задайте свои значения.
# Для локальной разработки без Docker: переменные из последней секции скопируйте
# в backend/.env и frontend/.env (см. их .env.example).
#
# Пустые секреты ниже compose молча подменит локальными дефолтами – это годится
# только для локального запуска.

# ── Портал и compose ──────────────────────────────────────────────────────────

# Название портала. Уходит build-аргументом во фронтенд как VITE_APP_NAME, поэтому
# после изменения нужна пересборка: docker compose up --build
APP_NAME=ННГАСУ

# Внешний адрес портала: используется как CORS_ORIGIN для API и Socket.IO.
PUBLIC_URL=http://localhost:8080

# Порт, на котором фронтенд публикуется наружу (слушается только на 127.0.0.1).
FRONTEND_PORT=8080

# Лимит тела запроса nginx, МБ. Должен покрывать несколько файлов в одном запросе:
# бэкенд ограничивает каждый файл через MAX_UPLOAD_MB, но принимает до 10 файлов.
NGINX_CLIENT_MAX_BODY_MB=100

# Порт API внутри контейнера backend. Наружу он не публикуется – снаружи
# доступен только фронтенд.
BACKEND_PORT=4000

# Часовой пояс контейнеров.
TZ=Europe/Moscow

# ── Postgres ─────────────────────────────────────────────────────────────────

# Реквизиты Postgres. DATABASE_URL для контейнера backend compose собирает сам
# из этих трех значений.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms

# ── Бэкенд (см. backend/src/config.ts) ───────────────────────────────────────

# Секреты подписи. В продакшене обязательны и должны быть случайными:
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_URL_SECRET=

# Время жизни access-токена (формат ms: 15m, 1h) и refresh-токена в днях.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Сколько живет подписанная ссылка на файл.
FILE_URL_TTL_SEC=3600

# true – refresh-cookie отдается только по HTTPS. Включать вместе с HTTPS.
COOKIE_SECURE=false

# Каталог загрузок внутри контейнера. Должен быть абсолютным: он же служит
# target для тома uploads.
UPLOAD_DIR=/app/uploads

# Максимальный размер одного загружаемого файла, МБ.
MAX_UPLOAD_MB=10

# Понедельник первой (нечетной) учебной недели: от него считается номер
# и четность недели в расписании.
SEMESTER_START=2026-09-01

# Окно, в течение которого повторное использование старого refresh-токена
# не считается атакой (защита от гонки при параллельном refresh), мс.
REFRESH_REUSE_GRACE_MS=10000

# ── Только для локальной разработки без Docker ───────────────────────────────
# Docker compose эти переменные не использует: копируйте их в backend/.env
# и frontend/.env.

# Подключение к Postgres, опубликованному compose'ом на localhost.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public

# Тестовая база для `npm test` (создается автоматически скриптом docker/postgres-init.sh).
TEST_DATABASE_URL=postgresql://lms:lms@localhost:5432/lms_test?schema=public

# Адрес бэкенда для dev-прокси Vite.
VITE_API_PROXY=http://localhost:4000

# true – seed перезапишет данные при запуске `npm run seed`.
SEED_FORCE=false
