# Шаблон nginx: при старте контейнера штатный envsubst образа
# (docker-entrypoint.d/20-envsubst-on-templates.sh) подставляет ${...} из окружения
# и пишет результат в /etc/nginx/conf.d/default.conf, перезаписывая дефолтный конфиг.
# Переменные самого nginx ($host, $uri, $scheme и т.п.) не трогаются: envsubst
# заменяет только то, что есть в окружении контейнера.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Лимит тела запроса должен покрывать несколько файлов сразу: backend ограничивает
  # каждый файл через MAX_UPLOAD_MB, но принимает до 10 файлов в одном запросе.
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_MB}m;

  location /api/ {
    proxy_pass http://backend:${BACKEND_PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 1h;
  }

  # Ассеты с хешем в имени кешируются надолго
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA: все остальные пути отдают index.html
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
