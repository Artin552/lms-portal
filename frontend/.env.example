# Локальный запуск фронтенда без Docker: скопируйте файл в frontend/.env.
#
# Полный список переменных и их назначение – в корневом ../.env.example.
# Обе переменные необязательны: по умолчанию название портала "ННГАСУ",
# dev-прокси смотрит на http://localhost:4000.

# Название портала (шапка, страница входа, вкладка браузера)
VITE_APP_NAME=ННГАСУ
# Куда dev-сервер Vite проксирует /api и /socket.io
VITE_API_PROXY=http://localhost:4000
