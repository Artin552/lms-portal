# Подключение к PostgreSQL (локально — к контейнеру db из docker-compose)
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public
# Тестовая БД для `npm test` (создаётся автоматически скриптом docker/postgres-init.sql)
TEST_DATABASE_URL=postgresql://lms:lms@localhost:5432/lms_test?schema=public

PORT=4000
# Адрес фронтенда (для CORS и Socket.IO), можно несколько через запятую
CORS_ORIGIN=http://localhost:5173

# Секреты — обязательно замените в продакшене (например: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
FILE_URL_SECRET=dev-file-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# true — refresh-cookie только по HTTPS (включить в продакшене)
COOKIE_SECURE=false

# Файлы
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
FILE_URL_TTL_SEC=3600

# Понедельник первой (нечётной) учебной недели
SEMESTER_START=2026-09-01
